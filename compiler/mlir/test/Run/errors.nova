# RUN: nova-compile %s -o %t.exe
# RUN: not %t.exe 2>&1 | FileCheck %s
#
# A runtime error stops the compiled program as it stops the interpreter: the same message, with the Nova line,
# and exit status 1. nova-compile keeps every op's line from the source to the runtime call.

ignite:
    Tensor a = ones(2, 3)
    # CHECK: 1.000000
    print(a[1, 2])
    Tensor b = ones(3, 2)
    # CHECK-NEXT: {{.*}}errors.nova:[[@LINE+1]]: runtime error[R0003]: '+' needs tensors of the same shape, got (2, 3) and (3, 2)
    print(a + b)
    print(a)
