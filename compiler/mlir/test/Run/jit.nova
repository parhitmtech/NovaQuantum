# RUN: env NOVA_SEED=3 nova-compile %s --run --hardware --qnova-stats 2>&1 | FileCheck %s
#
# --run: the program compiled through MLIR and LLVM in memory (LLVM's JIT) and run at once, nothing written, as the
# cloud IDE runs it in its sandbox. Teleportation has control flow (its corrections), so --hardware leaves it at
# native gates; the stats show them, then the program's output.

# CHECK: qnova-stats @main: 3 qubits
# CHECK-NOT: atom-timing
# CHECK: |0>: 0.2500
# CHECK-NEXT: |1>: 0.7500

ignite:
    qubit a = qpu.alloc()
    qubit b = qpu.alloc()
    qubit c = qpu.alloc()
    qpu.ry(a, 2.0943951023931953)   # the state to send: |1> with probability 0.75
    qpu.h(b)
    qpu.cx(b, c)                     # b and c entangled
    qpu.cx(a, b)
    qpu.h(a)
    bool m1 = qpu.measure(a)
    bool m2 = qpu.measure(b)
    if (m2):
        qpu.x(c)
    if (m1):
        qpu.z(c)
    qpu.probs(c)                     # |0>: 0.2500  |1>: 0.7500, whatever was measured
