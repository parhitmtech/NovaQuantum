{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OpenQASM",
  "scopeName": "source.openqasm",
  "fileTypes": ["qasm"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#header" },
    { "include": "#strings" },
    { "include": "#gate-definition" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#gates" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "Nova's directive in a comment: // nova.probs q[0], q[1] prints those qubits' probabilities",
          "match": "(//)\\s*(nova\\.probs)\\b(.*)$",
          "captures": {
            "1": { "name": "comment.line.double-slash.openqasm punctuation.definition.comment.openqasm" },
            "2": { "name": "keyword.other.directive.nova.openqasm" },
            "3": { "name": "comment.line.double-slash.openqasm" }
          }
        },
        { "name": "comment.line.double-slash.openqasm", "match": "//.*$" },
        { "name": "comment.block.openqasm", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "header": {
      "patterns": [
        {
          "match": "\\b(OPENQASM)\\s+(\\d+(?:\\.\\d+)?)",
          "captures": {
            "1": { "name": "keyword.other.version.openqasm" },
            "2": { "name": "constant.numeric.version.openqasm" }
          }
        },
        {
          "match": "\\b(include)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.control.import.openqasm" },
            "2": { "name": "string.quoted.double.openqasm" }
          }
        },
        { "name": "keyword.other.pragma.openqasm", "match": "^\\s*(pragma|#pragma)\\b.*$" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.openqasm",
      "begin": "\"",
      "end": "\"|$"
    },
    "gate-definition": {
      "match": "\\b(gate|def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.openqasm" },
        "2": { "name": "entity.name.function.openqasm" }
      }
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.flow.openqasm", "match": "\\b(if|else|for|while|in|return|break|continue|end|switch|case|default|box)\\b" },
        { "name": "keyword.other.quantum.openqasm", "match": "\\b(measure|reset|barrier|delay|ctrl|negctrl|inv|pow|gphase)\\b" },
        { "name": "storage.modifier.openqasm", "match": "\\b(const|input|output|let|extern|defcal|defcalgrammar|cal|opaque)\\b" }
      ]
    },
    "types": {
      "name": "storage.type.openqasm",
      "match": "\\b(qubit|qreg|bit|creg|int|uint|float|angle|bool|complex|duration|stretch|array)\\b"
    },
    "gates": {
      "comment": "The standard gates (stdgates.inc and the built-ins)",
      "name": "support.function.gate.openqasm",
      "match": "\\b(h|x|y|z|s|sdg|t|tdg|sx|rx|ry|rz|p|phase|cx|CX|cy|cz|cp|cphase|crx|cry|crz|ch|swap|ccx|cswap|cu|u|U|u1|u2|u3|id)\\b(?=\\s*[(\\[A-Za-z_$])"
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.openqasm", "match": "\\b(pi|tau|euler|true|false)\\b|π|τ|ℇ" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.duration.openqasm", "match": "\\b\\d+(?:\\.\\d+)?(?:ns|us|µs|ms|s|dt)\\b" },
        { "name": "constant.numeric.float.openqasm", "match": "\\b\\d+\\.\\d*(?:[eE][+-]?\\d+)?|\\b\\d+[eE][+-]?\\d+|\\.\\d+(?:[eE][+-]?\\d+)?" },
        { "name": "constant.numeric.integer.openqasm", "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.openqasm", "match": "->" },
        { "name": "keyword.operator.comparison.openqasm", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.openqasm", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.openqasm", "match": "\\+=|-=|\\*=|/=|=" },
        { "name": "keyword.operator.arithmetic.openqasm", "match": "\\*\\*|[+\\-*/%&|^~]" },
        { "name": "keyword.operator.modifier.openqasm", "match": "@" }
      ]
    },
    "identifiers": {
      "name": "variable.other.openqasm",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.openqasm", "match": ";" },
        { "name": "punctuation.separator.comma.openqasm", "match": "," },
        { "name": "punctuation.section.brackets.openqasm", "match": "[\\[\\]]" },
        { "name": "punctuation.section.parens.openqasm", "match": "[()]" },
        { "name": "punctuation.section.braces.openqasm", "match": "[{}]" }
      ]
    }
  }
}
